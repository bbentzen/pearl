import ./equiv.prl

universe ℓ

/* Equivalence class */

def class_eq {A : type ℓ} (R : A → A → type ℓ) (e : is_equiv R) (a b : A) (d : R a b) : 
  eq (A / R) ([a] R) ([b] R) :=
reflect d rfl