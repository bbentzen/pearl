universe ℓ

/* Function application and extensionality */

thm ap {A B : type ℓ} (f : A → B) {a b : A} :
  eq A a b → eq B (f a) (f b) :=
λ p, reflect p rfl

def eta {A B : type ℓ} (f : A → B) :
  eq (A → B) (λ x, f x) f :=
rfl

def apd {A : type ℓ} {B : A → type ℓ} (f : Π (x : A), B x) {a b : A} (p : eq A a b) :
  eq (B a) (f a) (reflect p (f b)) :=
reflect p rfl

thm etad {A : type ℓ} {B : A → type ℓ} (f : Π (x : A), B x) :
  eq (Π (x : A), B x) (λ x, f x) f :=
rfl

thm funext {A : type ℓ} {B : A → type ℓ} (f g : Π (x : A), B x) :
  (Π (x : A), eq (B x) (f x) (g x)) → eq (Π (x : A), B x) f g :=
λ h, reflect (etad f) reflect (etad g) (λ x, (reflect (h x) rfl) x)

/* Injectivity of non-dependent function former */

thm fun_inj_dom {A A' B B' : type ℓ} :
  eq (type ℓ) (A → B) (A' → B') → eq (type ℓ) A A' :=
λ p, reflect p rfl

thm fun_inj_codom {A A' B B' : type ℓ} :
  eq (type ℓ) (A → B) (A' → B') → eq (type ℓ) B B' :=
λ p, reflect p rfl

/* Injectivity of dependent function former */

thm dfun_inj_dom {A A' : type ℓ} {B : A → type ℓ} {B' : A' → type ℓ} :
  eq (type ℓ) (Π (x : A), B x) (Π (x : A'), B' x) → eq (type ℓ) A A' :=
λ p, reflect p rfl

thm dfun_inj_codom {A A' : type ℓ} {B : A → type ℓ} {B' : A' → type ℓ} :
  Π (p : eq (type ℓ) (Π (x : A), B x) (Π (x : A'), B' x)), 
  reflect p (Π (x : A), eq (type ℓ) (B x) (B' x)) :=
λ p x, reflect p rfl