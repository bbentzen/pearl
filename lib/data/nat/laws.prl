import ../../core/equality.prl
import ../sigma/basic.prl
import ../unit.prl
import ./basic.prl

/* Some numerical equations */

thm add_zero (m : nat) :
  eq nat (add 0 m) m :=
natrec _ rfl (λ n p, reflect p rfl) m

thm eq_of_succ {n m : nat} :
  eq nat (succ n) (succ m) → eq nat n m :=
λ p, ap (λ x, natrec _ n (λ k _, k) x) p

thm succ_of_eq {n m : nat} :
  eq nat n m → eq nat (succ n) (succ m) :=
λ p, reflect p rfl

thm succ_iff_eq {n m : nat} :
  eq nat (succ n) (succ m) ↔ eq nat n m :=
(eq_of_succ, succ_of_eq)

thm pred_succ {n : nat} :
  eq nat (pred (succ n)) n :=
rfl

