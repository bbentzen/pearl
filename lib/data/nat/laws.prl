import ../../core/equality.prl
import ../sigma/lemmas.prl
import ../unit.prl
import ./basic.prl

/* Some numerical equations */

thm add_zero (m : nat) :
  eq nat (add 0 m) m :=
natrec _ rfl (λ n p, reflect p rfl) m

thm eq_of_succ {n m : nat} :
  eq nat (succ n) (succ m) → eq nat n m :=
λ p, ap (λ x, natrec _ n (λ k _, k) x) p

thm succ_of_eq {n m : nat} :
  eq nat n m → eq nat (succ n) (succ m) :=
λ p, reflect p rfl

thm succ_iff_eq {n m : nat} :
  eq nat (succ n) (succ m) ↔ eq nat n m :=
(eq_of_succ, succ_of_eq)

thm pred_succ (n : nat) :
  eq nat (pred (succ n)) n :=
rfl

thm succ_pred {n : nat} :
  (Σ (k : nat), eq nat (succ k) n) → eq nat (succ (pred n)) n :=
λ w, reflect (sigmarec _ _ (λ v, eq nat (succ (sigmarec _ _ _ (λ x _, x) v)) n) (λ _ y, y) w) 
(ap succ (pred_succ (fst w)))

/* Inequalities */

thm nat_neq {n : nat} :
  ¬ eq nat 0 (succ n) :=
λ p, transport (λ n, natrec _ unit (λ _ _, void) n) p ()

thm nat_neq' {n : nat} :
  ¬ eq nat (succ n) 0 :=
λ p, transport (λ n, natrec _ void (λ _ _, unit) n) p ()

/* Basic arithmetical laws */

thm add_assoc (m n k : ℕ) :
  eq ℕ (add (add m n) k) (add m (add n k)) :=
natrec _ rfl (λ k ih, succ_of_eq ih) k

thm add_comm_zero (m : ℕ) :
  eq ℕ m (add 0 m) :=
natrec _ rfl (λ k ih, succ_of_eq ih) m

thm add_comm_succ (l n : ℕ) :
  eq ℕ (add (succ l) n) (succ (add l n)) :=
natrec _ rfl (λ _ ih, succ_of_eq ih) n 

thm add_comm (m n : ℕ) :
  eq ℕ (add m n) (add n m) :=
natrec _ (add_zero n) (λ k ih, (add_comm_succ k n) · (succ_of_eq ih)) m

thm add_num_left {m n : ℕ} (k : ℕ) :
  eq ℕ m n → eq ℕ (add k m) (add k n) :=
λ p, reflect p rfl

thm add_num_right {m n : ℕ} (k : ℕ) :
  eq ℕ m n → eq ℕ (add m k) (add n k) :=
λ p, reflect p rfl

thm add_eq_left {m n k l : ℕ} (p : eq ℕ k l) :
  eq ℕ m n → eq ℕ (add k m) (add l n) :=
λ q, reflect p reflect q rfl

thm add_eq_right {m n k l : ℕ} (p : eq ℕ k l) :
  eq ℕ m n → eq ℕ (add m k) (add n l) :=
λ q, reflect p reflect q rfl

thm add_two {m n k l : ℕ} :
  eq ℕ m n → eq ℕ k l → eq ℕ (add m k) (add n l) :=
λ p q, reflect p reflect q rfl

thm add_num_inj {m n k : ℕ} :
  eq ℕ (add m k) (add n k) → eq ℕ m n :=
natrec _ id (λ i ih p, ih (eq_of_succ p)) k

thm add_eq_inj {m n k l : ℕ} (p : eq ℕ k l) :
  eq ℕ (add m k) (add n l) → eq ℕ m n :=
λ q, reflect p (add_num_inj q)

thm add_comm2 (m n k : ℕ) :
  eq ℕ (add (add m n) k) (add (add m k) n) :=
(add_assoc m n k) · (add_num_left m (add_comm n k)) · (add_assoc m k n)⁻¹

thm add_pair_symm (m n : ℕ) {x y : ℕ} :
  eq ℕ (add (add m x) (add n y))  (add (add m n) (add x y)) :=
((add_assoc m x (add n y)) · (add_num_left m (add_assoc x n y)⁻¹)) ·
((add_num_left m (add_num_right y (add_comm x n))) · (add_assoc m (add n x) y)⁻¹) ·
 ((add_assoc (add m n) x y)⁻¹ · (add_assoc (add m n) x y))

/* Code-decode */

def nat_code (n m : nat) :
  type 1 :=
natrec _ (natrec _ (eq nat 0 0) (λ _ _, void) m) 
(λ n' C, natrec _ void (λ m' _, eq nat (succ n') (succ m')) m) n
 
thm nat_eq {n m : nat} :
  eq nat n m ↔ nat_code n m :=
natrec _ (natrec _ id_iff_id (λ k _, (nat_neq, absurd)) m)
(λ k _, natrec _ (nat_neq', absurd) (λ k' _, id_iff_id) m) n 