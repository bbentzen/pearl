import ./lemmas.prl

universe ℓ

/* Equalities over pairs */

def prod_eta (A B : type ℓ) (w : A × B) :
  eq (A × B) w (fst w, snd w) :=
sigmarec A (λ _, B) _ (λ x y, rfl) w

